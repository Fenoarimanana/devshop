# Database
# IMPORTANT for Vercel (serverless): use a pooled connection URL.
# Neon example: postgresql://user:pass@host/db?sslmode=require&pgbouncer=true&connect_timeout=15
# Supabase example: use the "Connection pooling" URL (port 6543), not the direct one (port 5432)
DATABASE_URL="postgresql://user:password@localhost:5432/devshop"

# NextAuth
# IMPORTANT: On Vercel, set NEXTAUTH_URL to your real deployed URL, e.g. https://devshop.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Admin (super admin défini ici, pas via inscription)
ADMIN_EMAIL="admin@devshop.com"
ADMIN_PASSWORD="change-this-strong-password"

# NOWPayments
NOWPAYMENTS_API_KEY="your-nowpayments-api-key"
NOWPAYMENTS_IPN_SECRET="your-ipn-secret"
NOWPAYMENTS_CURRENCY="usdttrc20"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# App
# IMPORTANT: On Vercel, this MUST match your real deployed domain (used in emails, NOWPayments redirect URLs, sitemap)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DevShop"

# Email (optional - Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="DevShop <noreply@devshop.com>"

# Download token expiry (hours)
DOWNLOAD_TOKEN_EXPIRY_HOURS="48"
